C_OBJS = \
  $O/Alloc.o \
  $O/CpuArch.o \
  $O/DllSecur.o \
  $O/Sort.o \
  $O/Threads.o \
  $O/7zCrc.o \
  $O/7zCrcOpt.o \
  $O/Transpose.o \
  $O/LzmaEnc.o \
  $O/LzFind.o \
  $O/LzFindMt.o \
  $O/LzFindOpt.o \
