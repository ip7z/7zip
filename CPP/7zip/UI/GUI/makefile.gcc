OBJS = \
  $(C_OBJS) \
  $(COMMON_OBJS) \
  $(WIN_OBJS) \
  $(WIN_CTRL_OBJS) \
  $(COMPRESS_OBJS) \
  $(AR_COMMON_OBJS) \
  $(7ZIP_COMMON_OBJS) \
  $(UI_COMMON_OBJS) \
  $(FM_OBJS) \
  $(EXPLORER_OBJS) \
  $(GUI_OBJS) \
  $O/resource.o \

include ../../7zip_gcc.mak
